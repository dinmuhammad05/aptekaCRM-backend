// Apteka CRM ma'lumotlar bazasi sxemasi
// Prisma + PostgreSQL
// Multi-tenant (SaaS): har bir apteka — alohida "tenant" (Pharmacy).
// Asosiy modellar `pharmacyId` bilan bog'lanadi; izolyatsiya Prisma
// middleware orqali avtomatik qo'llanadi (src/prisma/tenant-scope.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Apteka obuna holati (SaaS) — admin qo'lda boshqaradi
enum PharmacyStatus {
  ACTIVE // faol
  BLOCKED // bloklangan (obuna to'lanmagan va h.k.)
}

/// Apteka (tenant) — SaaS mijozi
model Pharmacy {
  id                 Int            @id @default(autoincrement())
  name               String // apteka nomi
  ownerName          String? // egasi (mas'ul shaxs)
  phone              String? // bog'lanish raqami
  status             PharmacyStatus @default(ACTIVE)
  subscriptionEndsAt DateTime? // obuna tugash sanasi (null = muddatsiz)
  monthlyPrice       Decimal?       @db.Decimal(12, 2) // oylik obuna narxi (SaaS)
  telegramChatId     String? // Telegram chat ID (kunlik xulosa/ogohlantirish yuboriladi)
  note               String? // admin uchun izoh
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  users         User[]
  products      Product[]
  batches       Batch[]
  sales         Sale[]
  returns       Return[]
  notifications Notification[]
  payments      SubscriptionPayment[]
  customers     Customer[]
  suppliers     Supplier[]
  shifts        Shift[]
  expenses      Expense[]

  @@index([status])
}

/// Operatsion xarajat (ijara, oylik, kommunal va h.k.) — sof foyda uchun
model Expense {
  id         Int      @id @default(autoincrement())
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId Int
  category   String // ijara, oylik, kommunal, boshqa
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  userId     Int? // kim kiritdi
  spentAt    DateTime @default(now()) // xarajat sanasi
  createdAt  DateTime @default(now())

  @@index([pharmacyId])
  @@index([pharmacyId, spentAt])
}

/// Obuna to'lovi — superadmin obunani uzaytirganda yoziladi (SaaS daromadi).
/// Global jadval (faqat superadmin ishlatadi), tenant izolyatsiyasidan tashqari.
model SubscriptionPayment {
  id         Int      @id @default(autoincrement())
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId Int
  months     Int // qancha oyga uzaytirildi
  amount     Decimal  @db.Decimal(12, 2) // to'langan summa (monthlyPrice * months)
  createdAt  DateTime @default(now())

  @@index([pharmacyId])
  @@index([createdAt])
}

/// Dori katalogi (mahsulot kartochkasi)
model Product {
  id               Int        @id @default(autoincrement())
  pharmacy         Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId       Int
  name             String
  barcode          String?
  manufacturer     String?
  form             String? // tabletka, sirop, ampula va h.k.
  activeIngredient String? // ta'sir moddasi (MNN) — analoglarni guruhlash uchun
  unit             String     @default("dona") // eng kichik o'lchov birligi (dona)
  unitsPerPack     Int        @default(1) // pachkadagi dona soni (sirop uchun 1)
  description      String?
  minStock         Int        @default(0) // kam qolish chegarasi (ogohlantirish uchun)
  defaultCostPrice Decimal?   @db.Decimal(12, 2) // katalog/tavsiya kelish narxi (prixodda taklif qilinadi)
  defaultSellPrice Decimal?   @db.Decimal(12, 2) // katalog/tavsiya sotish narxi
  isQuickSelect    Boolean    @default(false) // kassada tezkor qo'shish uchun podskazka
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  batches          Batch[]
  saleItems        SaleItem[]

  // Barcode apteka ichida unique (turli aptekalarda bir xil barcode bo'lishi mumkin)
  @@unique([pharmacyId, barcode])
  @@index([pharmacyId])
  @@index([pharmacyId, name])
  @@index([pharmacyId, activeIngredient])
}

/// Partiya (prixod) — har bir kelish alohida narx va yaroqlilik muddatiga ega
model Batch {
  id          Int        @id @default(autoincrement())
  pharmacy    Pharmacy   @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId  Int
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   Int
  batchNumber String? // partiya raqami (ixtiyoriy)
  expiryDate  DateTime // yaroqlilik muddati
  quantity    Int // joriy qoldiq (DONADA)
  costPrice   Decimal    @db.Decimal(12, 2) // pachka kelish narxi
  sellPrice   Decimal    @db.Decimal(12, 2) // pachka sotish narxi
  receivedAt  DateTime   @default(now())
  supplier    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId  Int? // qaysi ta'minotchidan keldi (ixtiyoriy)
  saleItems   SaleItem[]

  @@index([pharmacyId])
  @@index([productId])
  @@index([expiryDate])
  @@index([supplierId])
}

/// Xabarlar:
///  - pharmacyId to'la bo'lsa — apteka kassiri uchun (PRICE_DROP, CATALOG_SKIPPED)
///  - pharmacyId null bo'lsa — SUPERADMIN uchun (SUBSCRIPTION_EXPIRED va h.k.)
model Notification {
  id          Int       @id @default(autoincrement())
  pharmacy    Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId  Int?
  type        String    @default("PRICE_DROP") // xabar turi
  productId   Int? // tegishli dori (ixtiyoriy)
  productName String // dori nomi yoki apteka nomi (xabar matnida ko'rsatish uchun)
  oldPrice    Decimal?  @db.Decimal(12, 2) // eski (saqlangan) sotish narxi
  newPrice    Decimal?  @db.Decimal(12, 2) // import qilingan past narx
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([pharmacyId])
  @@index([read])
  @@index([createdAt])
}

enum PaymentType {
  CASH
  CARD
}

/// Kassir smenasi holati
enum ShiftStatus {
  OPEN // ochiq
  CLOSED // yopilgan
}

/// Foydalanuvchi roli
enum Role {
  SUPERADMIN // SaaS egasi (barcha aptekalarni boshqaradi)
  ADMIN // apteka egasi/boshqaruvchisi
  CASHIER // kassir
}

/// Tizim foydalanuvchisi (superadmin / apteka admini / kassir)
model User {
  id           Int       @id @default(autoincrement())
  // SUPERADMIN uchun null (aptekaga bog'lanmaydi)
  pharmacy     Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId   Int?
  username     String    @unique
  passwordHash String
  name         String?
  avatarUrl    String? // profil rasmi (base64 data URL, kichik o'lchamga siqilgan)
  role         Role      @default(CASHIER)
  createdAt    DateTime  @default(now())
  sales        Sale[]
  returns      Return[]
  shifts       Shift[]

  @@index([pharmacyId])
}

/// Sotuv birligi: butun pachka yoki dona (donalab)
enum SaleUnit {
  PACK
  PIECE
}

/// Sotuv cheki
model Sale {
  id          Int         @id @default(autoincrement())
  pharmacy    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId  Int
  subtotal    Decimal     @default(0) @db.Decimal(12, 2) // chegirmagacha jami
  discount    Decimal     @default(0) @db.Decimal(12, 2) // qo'llanilgan chegirma (so'mda)
  total       Decimal     @db.Decimal(12, 2) // yakuniy to'lov (subtotal - discount)
  paid        Decimal     @default(0) @db.Decimal(12, 2) // sotuv paytida to'langan summa (qarz = total - paid)
  paymentType PaymentType @default(CASH)
  createdAt   DateTime    @default(now())
  items       SaleItem[]
  user        User?       @relation(fields: [userId], references: [id])
  userId      Int? // sotuvni amalga oshirgan kassir
  customer    Customer?   @relation(fields: [customerId], references: [id])
  customerId  Int? // nasiya (qarz) savdosida mijoz
  shift       Shift?      @relation(fields: [shiftId], references: [id])
  shiftId     Int? // sotuv tegishli bo'lgan kassir smenasi
  returns     Return[]

  @@index([pharmacyId])
  @@index([pharmacyId, createdAt])
  @@index([userId])
  @@index([customerId])
  @@index([shiftId])
}

/// Kassir smenasi — ochish/yopish, naqd kassani solishtirish (X/Z hisobot)
model Shift {
  id          Int         @id @default(autoincrement())
  pharmacy    Pharmacy    @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId  Int
  user        User?       @relation(fields: [userId], references: [id])
  userId      Int? // smenani ochgan kassir
  openingCash Decimal     @default(0) @db.Decimal(12, 2) // boshlang'ich kassa naqdi
  closingCash Decimal?    @db.Decimal(12, 2) // yopilganda sanab chiqilgan naqd
  status      ShiftStatus @default(OPEN)
  openedAt    DateTime    @default(now())
  closedAt    DateTime?
  note        String?
  sales       Sale[]

  @@index([pharmacyId])
  @@index([pharmacyId, status])
  @@index([userId])
}

/// Mijoz (doimiy xaridor) — nasiya/qarz savdosi va sodiqlik uchun
model Customer {
  id         Int               @id @default(autoincrement())
  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId Int
  name       String
  phone      String?
  note       String?
  debt       Decimal           @default(0) @db.Decimal(12, 2) // joriy qarz (kesh; to'lov/savdo bilan yangilanadi)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  sales      Sale[]
  payments   CustomerPayment[]

  @@index([pharmacyId])
  @@index([pharmacyId, name])
}

/// Mijoz qarzini kamaytiruvchi to'lov (audit izi)
model CustomerPayment {
  id         Int      @id @default(autoincrement())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId Int
  pharmacyId Int // tenant izolyatsiyasi (ustun bo'yicha)
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  userId     Int? // to'lovni qabul qilgan kassir
  createdAt  DateTime @default(now())

  @@index([pharmacyId])
  @@index([customerId])
}

/// Ta'minotchi (postavshik) — dorilar keladigan yetkazib beruvchi
model Supplier {
  id         Int               @id @default(autoincrement())
  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId Int
  name       String
  phone      String?
  note       String?
  debt       Decimal           @default(0) @db.Decimal(12, 2) // ularga qarzimiz (prixodda oshadi, to'lovda kamayadi)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  batches    Batch[]
  payments   SupplierPayment[]

  @@index([pharmacyId])
  @@index([pharmacyId, name])
}

/// Ta'minotchiga qilingan to'lov (qarzni kamaytiradi, audit izi)
model SupplierPayment {
  id         Int      @id @default(autoincrement())
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId Int
  pharmacyId Int // tenant izolyatsiyasi (ustun bo'yicha)
  amount     Decimal  @db.Decimal(12, 2)
  note       String?
  userId     Int? // to'lovni kiritgan foydalanuvchi
  createdAt  DateTime @default(now())

  @@index([pharmacyId])
  @@index([supplierId])
}

/// Chek qatori (qaysi partiyadan qancha sotildi) — apteka chek (Sale) orqali aniqlanadi
model SaleItem {
  id          Int          @id @default(autoincrement())
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId      Int
  product     Product      @relation(fields: [productId], references: [id])
  productId   Int
  batch       Batch        @relation(fields: [batchId], references: [id])
  batchId     Int
  unit        SaleUnit     @default(PACK) // pachka yoki dona sotildi
  quantity    Int // sotilgan birlikdagi son (pachka soni yoki dona soni)
  price       Decimal      @db.Decimal(12, 2) // o'sha birlik narxi (sotuv paytida muzlatilgan)
  subtotal    Decimal      @db.Decimal(12, 2)
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId]) // dori o'chirish va dori bo'yicha tahlil uchun
  @@index([batchId]) // partiya o'chirish/qidirish uchun
}

/// Qaytarish (vozvrat) — sotilgan dori(lar)ning bir qismi yoki hammasi qaytariladi
model Return {
  id         Int          @id @default(autoincrement())
  pharmacy   Pharmacy     @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  pharmacyId Int
  sale       Sale         @relation(fields: [saleId], references: [id])
  saleId     Int
  user       User?        @relation(fields: [userId], references: [id])
  userId     Int? // qaytarishni amalga oshirgan kassir
  total      Decimal      @db.Decimal(12, 2) // qaytarilgan summa
  createdAt  DateTime     @default(now())
  items      ReturnItem[]

  @@index([pharmacyId])
  @@index([saleId])
  @@index([createdAt])
}

/// Qaytarish qatori (qaysi chek qatoridan qancha qaytarildi) — apteka chek orqali aniqlanadi
model ReturnItem {
  id         Int      @id @default(autoincrement())
  return     Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  returnId   Int
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])
  saleItemId Int
  quantity   Int // qaytarilgan birlik soni (sotuv birligida)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([returnId])
  @@index([saleItemId])
}

/// Tayyor "packet" (shablon katalog) — SUPERADMIN tuzadi, aptekalar o'ziga
/// klonlaydi. Global (pharmacyId yo'q) — tenant izolyatsiyasidan tashqarida.
model Packet {
  id          Int          @id @default(autoincrement())
  name        String // packet nomi (mas. "Standart dorixona")
  description String? // izoh
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  items       PacketItem[]
}

/// Packetdagi bitta dori shabloni. Klonlashda apteka Product'iga ko'chiriladi
/// (barcode + unitsPerPack + tavsiya narx), qoldiq esa 0 dan boshlanadi.
model PacketItem {
  id               Int      @id @default(autoincrement())
  packet           Packet   @relation(fields: [packetId], references: [id], onDelete: Cascade)
  packetId         Int
  name             String
  barcode          String?
  manufacturer     String?
  form             String?
  unit             String   @default("dona")
  unitsPerPack     Int      @default(1)
  defaultCostPrice Decimal? @db.Decimal(12, 2) // tavsiya kelish narxi
  sellPrice        Decimal? @db.Decimal(12, 2) // tavsiya sotuv narxi
  quantity         Int      @default(0) // admin uchun boshlang'ich qoldiq (klonga ko'chmaydi)
  createdAt        DateTime @default(now())

  @@index([packetId])
}
